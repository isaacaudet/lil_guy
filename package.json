{
  "name": "lil_guy",
  "version": "0.1.0",
  "description": "Deterministic pixel art avatars from any string",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./next": {
      "import": "./dist/next/index.js",
      "types": "./dist/next/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsdown",
    "test": "bun test",
    "dev": "tsdown --watch"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "@types/react": "",
    "next": ">=15"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsdown": "^0.9",
    "typescript": "^5.7",
    "react": "^19",
    "@types/react": "^19"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isaacaudet/lil_guy.git"
  },
  "keywords": [
    "avatar",
    "pixel-art",
    "deterministic",
    "identicon",
    "react",
    "nextjs",
    "svg",
    "headless",
    "typescript"
  ]
}
