{
  "name": "lil_guy",
  "version": "0.6.0",
  "description": "Deterministic pixel art avatars from any string",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./next": {
      "import": "./dist/next/index.js",
      "types": "./dist/next/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "bun test",
    "verify:shaders": "node scripts/verify-shaders.mjs",
    "verify:site": "node scripts/verify-site.mjs",
    "dev": "tsdown --watch",
    "showcase": "tsdown && cp dist/lil-guy.js docs/lil-guy.js && cp dist/lil-guy-element.js docs/lil-guy-element.js && cp dist/lilguys.js docs/lilguys.js && cp dist/kit/lilguys.js docs/lilguys.mjs && cp dist/lilguys-stadium.js docs/lilguys-stadium.js && cp dist/kit/lilguys-stadium.js docs/lilguys-stadium.mjs && bun scripts/build-showcase.ts",
    "test:cloudflare-auto": "node --test scripts/auto-deploy.test.mjs",
    "build:cloudflare-auto": "node scripts/auto-deploy.mjs",
    "deploy:cloudflare-auto": "node scripts/auto-deploy.mjs --deploy"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "@types/react": "",
    "next": ">=15"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19",
    "react": "^19",
    "react-dom": "^19",
    "tsdown": "^0.9",
    "typescript": "^5.7"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isaacaudet/lil_guy.git"
  },
  "keywords": [
    "avatar",
    "pixel-art",
    "deterministic",
    "identicon",
    "react",
    "nextjs",
    "svg",
    "headless",
    "typescript"
  ],
  "dependencies": {
    "jose": "^6.2.13"
  }
}
