{
  "name": "lilguys",
  "account_id": "c429945c593b00380ba3cd7910e715cb",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [{ "pattern": "lilguys.dleclub.com", "custom_domain": true }],
  "build": { "command": "bash scripts/build-site.sh" },
  "assets": { "directory": "./site", "binding": "ASSETS", "run_worker_first": ["/api/*", "/g/*", "/s/*", "/u/*", "/p/*", "/lilguys.js", "/lilguys.mjs", "/lilguys-stadium.js", "/lilguys-stadium.mjs"] },
  "d1_databases": [{ "binding": "DB", "database_name": "lilguys-names", "database_id": "701cf305-f299-46c1-ac7c-fed456d8079c", "migrations_dir": "migrations" }],
  "observability": { "enabled": false }
}
